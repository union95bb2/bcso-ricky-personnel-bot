# Private BCSO PAB Bot Sandbox configuration
#
# This file is safe to commit because it contains no token or application client ID.
# Copy it to the protected runtime .env on the sandbox host, then fill only the
# two values below from the Discord Developer Portal. Never paste a token into Discord.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# BCSO PAB Bot Sandbox server
DISCORD_GUILD_ID=1539377593638195301

# PAB and Command authorization roles
PAB_ROLE_ID=1539378360608890900
COMMAND_ROLE_ID=1539378505261907988

# PAB Records destinations
TRAINING_RECORDS_CHANNEL_ID=1539379472602759268
PERSONNEL_RECORDS_CHANNEL_ID=1539379482077691904
PAB_APPROVALS_CHANNEL_ID=1539379501556039841
AUDIT_LOG_CHANNEL_ID=1539379521122341034
QUALIFICATIONS_RECORDS_CHANNEL_ID=1539379532455346258
INACTIVITY_REVIEW_CHANNEL_ID=1539379549064790137
# Comma-separated approved Discord activity-source channel IDs.
ACTIVITY_CHANNEL_IDS=
PROMOTIONS_ANNOUNCEMENTS_CHANNEL_ID=1539379568723492874
PAB_ANNOUNCEMENTS_CHANNEL_ID=1539379640274133112
BIRTHDAY_CHANNEL_ID=
SERVICE_MILESTONES_CHANNEL_ID=

# Harmless sandbox-only role allow-lists. Move the role actually assigned to
# Ricky (verify with /pab-health) above these roles before testing mutations.
# Do not copy these values to the live server.
RANK_ROLE_IDS={"Deputy":"1539378576762347661","Corporal":"1539378593153421466"}
AWARDABLE_ROLE_IDS=1539378609821847643

TIME_ZONE_LABEL=MST
TIME_ZONE_ID=Etc/GMT+7
PENDING_ACTION_TTL_MINUTES=15
PENDING_REMINDER_MINUTES=5
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Roster!A:Z
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=
BCSO_BRAND_EMOJI=
PAB_DATA_PATH=data/pab.sandbox.sqlite
