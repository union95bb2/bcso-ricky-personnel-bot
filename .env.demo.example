# BCSO Bot Demo | TEST ONLY configuration
#
# This file intentionally contains no Discord token or application client ID.
# Copy it to the protected runtime configuration for the demo host, then fill
# only those two values from the Discord Developer Portal.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Separate demonstration guild. Do not use these IDs in the live BCSO server.
DISCORD_GUILD_ID=1539383172536467516

# PAB and Command authorization roles in the demo guild.
PAB_ROLE_ID=1539385099408375869
COMMAND_ROLE_ID=1539385249560268861

# Private PAB BOT WORKFLOWS | TEST ONLY destinations.
TRAINING_RECORDS_CHANNEL_ID=1539384811926458408
PERSONNEL_RECORDS_CHANNEL_ID=1539384829215375461
PAB_APPROVALS_CHANNEL_ID=1539384846412021891
AUDIT_LOG_CHANNEL_ID=1539384863461998592
QUALIFICATIONS_RECORDS_CHANNEL_ID=1539384880918565005
INACTIVITY_REVIEW_CHANNEL_ID=1539384885263859712
# Demo activity sources: general, go-on-duty, roll-call, bcso-general, bot-command.
ACTIVITY_CHANNEL_IDS=1539383173820059660,1539383782165971075,1539383799261954140,1539383816232247356,1539383851527176282
PROMOTIONS_ANNOUNCEMENTS_CHANNEL_ID=1539384902401663086
PAB_ANNOUNCEMENTS_CHANNEL_ID=1539384920273592391

# Harmless demo-only roles. Move Ricky Controller above each of these before
# testing promotion, award-role, or remove-role. Never use the server owner as
# the target: Discord never lets a bot manage the owner.
RANK_ROLE_IDS={"Deputy":"1539385257156022333","Corporal":"1539385265485910157"}
AWARDABLE_ROLE_IDS=1539385272255520900

TIME_ZONE_LABEL=MST
