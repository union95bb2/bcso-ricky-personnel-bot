# Discord Developer Portal credentials. Never commit the real token.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Restrict use to PAB and Command. Command is also permitted to approve promotions.
PAB_ROLE_ID=
COMMAND_ROLE_ID=

# Destination channels. Record channels should be read-only to normal members.
TRAINING_RECORDS_CHANNEL_ID=
PERSONNEL_RECORDS_CHANNEL_ID=
PROMOTIONS_ANNOUNCEMENTS_CHANNEL_ID=
AUDIT_LOG_CHANNEL_ID=
# Private channel visible only to PAB, Command, and the bot. Command promotions await approval here.
PAB_APPROVALS_CHANNEL_ID=
QUALIFICATIONS_RECORDS_CHANNEL_ID=
PAB_ANNOUNCEMENTS_CHANNEL_ID=
# Private PAB staff-attention queue. This workflow records neutral follow-up only;
# it never changes roles/access or applies disciplinary action.
INACTIVITY_REVIEW_CHANNEL_ID=
# Comma-separated approved Discord channels whose human messages count as activity.
# Ricky stores timestamps and source IDs only; it never stores message content.
ACTIVITY_CHANNEL_IDS=

# JSON object mapping the exact display name of each rank to its Discord role ID.
# Example: {"DST":"123","Deputy":"456","Senior Deputy":"789","Corporal":"012"}
RANK_ROLE_IDS={}

# Comma-separated IDs for roles PAB may award (certifications, units, or qualifications).
# Never include Command, administrator, moderation, or rank roles here.
AWARDABLE_ROLE_IDS=

# The label is printed beside both times. TIME_ZONE_ID controls which zone supplies
# the pre-filled "today" date. Use an IANA zone or a fixed offset such as Etc/GMT+7.
TIME_ZONE_LABEL=MST
TIME_ZONE_ID=Etc/GMT+7

# Optional exact BCSO custom-emoji markup, for example <:BCSO:123456789012345678>.
BCSO_BRAND_EMOJI=

# Private local SQLite file for durable pending approvals and searchable receipts.
# Keep this folder readable only by the bot host administrator and PAB-approved backups.
PAB_DATA_PATH=data/pab.sqlite
