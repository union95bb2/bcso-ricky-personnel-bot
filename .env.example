# Discord Developer Portal credentials. Never commit the real token.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Restrict use to PAB and Command. Command is also permitted to approve promotions.
PAB_ROLE_ID=
COMMAND_ROLE_ID=

# Destination channels. Record channels should be read-only to normal members.
TRAINING_RECORDS_CHANNEL_ID=
# Optional Phase 2 Forum destination. When set, Ricky creates one bot-posted
# thread per trainee and keeps the normal channel as the safe fallback.
TRAINING_RECORDS_FORUM_CHANNEL_ID=
PERSONNEL_RECORDS_CHANNEL_ID=
# Optional private Phase 2 Forum destination for one personnel-jacket thread
# per member. PAB/Command read; Ricky posts finalized records only.
PERSONNEL_JACKETS_FORUM_CHANNEL_ID=
PROMOTIONS_ANNOUNCEMENTS_CHANNEL_ID=
AUDIT_LOG_CHANNEL_ID=
# Private channel visible only to PAB, Command, and the bot. Command promotions await approval here.
PAB_APPROVALS_CHANNEL_ID=
QUALIFICATIONS_RECORDS_CHANNEL_ID=
PAB_ANNOUNCEMENTS_CHANNEL_ID=
# Private PAB staff-attention queue. This workflow records neutral follow-up only;
# it never changes roles/access or applies disciplinary action.
INACTIVITY_REVIEW_CHANNEL_ID=
# Optional announcement destinations. Leave blank to disable automatic notices.
BIRTHDAY_CHANNEL_ID=
SERVICE_MILESTONES_CHANNEL_ID=
# Comma-separated approved Discord channels whose human messages count as activity.
# Ricky Bot stores timestamps and source IDs only; it never stores message content.
ACTIVITY_CHANNEL_IDS=

# JSON object mapping the exact display name of each rank to its Discord role ID.
# The BCSO matrix must include every key below. Use the exact role IDs from the
# target guild; DST and Deputy Sheriff Trainee may point to the same role only
# when the server uses one role for both labels.
# Example: {"DST":"123","Deputy":"456","Senior Deputy":"789","Corporal":"012","Sergeant":"123","Staff Sergeant":"234","2nd Lieutenant":"345","1st Lieutenant":"456","Captain":"567","Major":"678","Commander":"789","Division Chief":"890","Chief Deputy":"901","Assistant Sheriff":"012","UnderSheriff":"123","Sheriff":"234"}
RANK_ROLE_IDS={}

# Comma-separated IDs for roles PAB may award (certifications, units, or qualifications).
# Never include Command, administrator, moderation, or rank roles here.
AWARDABLE_ROLE_IDS=

# The label is printed beside both times. TIME_ZONE_ID controls which zone supplies
# the pre-filled "today" date. Use an IANA zone or a fixed offset such as Etc/GMT+7.
TIME_ZONE_LABEL=MST
TIME_ZONE_ID=Etc/GMT+7

# Approval safety controls. Ricky Bot bounds the approval lifetime to 1 hour–7 days
# and the reminder window to 5 minutes–12 hours.
PENDING_ACTION_TTL_MINUTES=1440
PENDING_REMINDER_MINUTES=60

# Optional read-only Google Sheets roster comparison. Share the sheet with the
# service-account email; keep the JSON in the protected runtime environment.
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_RANGE=Roster!A:Z
GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON=

# Optional exact BCSO custom-emoji markup, for example <:BCSO:123456789012345678>.
BCSO_BRAND_EMOJI=

# Private local SQLite file for durable pending approvals and searchable receipts.
# Keep this folder readable only by the bot host administrator and PAB-approved backups.
PAB_DATA_PATH=data/pab.sqlite
